    "@fontsource/bungee": "^5.3.0",
    "@fontsource/metal-mania": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/rubik-glitch": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/syncopate": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@mediabunny/aac-encoder": "^1.65.2",
